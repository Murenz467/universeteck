# =====================================================================================
# Universe Tech - PRODUCTION settings.  Put these in Railway > your service > Variables.
# Never commit real values to GitHub.  Lines starting with # are explanations.
# Full step-by-step guide: DEPLOY.md
# =====================================================================================

# --- Required ---------------------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PASTE_A_LONG_RANDOM_VALUE_HERE
# Use your real domain once you own it. Until then use the https://....up.railway.app address Railway gives you.
SITE_URL=https://universetech.rw
# (ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS are filled in automatically from SITE_URL, www included.)
# DATABASE_URL is added by Railway when you attach the Postgres database. Do not type it.
# Do NOT set DEBUG. Leave it out so it stays off.

# --- Secret admin address (pick your own, keep the trailing slash) ---------------------
ADMIN_URL=ut-control-CHANGE-ME-7x2/

# --- Uploads must live on a Railway Volume (mount path /data) ---------------------------
MEDIA_ROOT=/data/media

# --- Email: sending (Railway Free/Hobby block SMTP, so we send through an HTTPS email service) ---
# Choose ONE provider:  resend  or  brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# BREVO_API_KEY=
# The address emails are sent from. The domain must be verified in your email service.
DEFAULT_FROM_EMAIL=Universe Tech <info@universetech.rw>
# Where staff notifications (new quote requests, payments reported...) are delivered:
NOTIFY_EMAIL=info@universetech.rw
# Shown in the website footer. Fill in only when the mailbox really exists:
CONTACT_EMAIL=

# --- First admin account (FIRST DEPLOY ONLY: delete these three lines after the first successful deploy) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- How clients pay (shown on invoices; only the ones you fill in appear) ----------------
MOMO_DETAILS=
AIRTEL_DETAILS=
BANK_DETAILS=

# --- Company details on contracts and invoices ---------------------------------------------
COMPANY_LEGAL_NAME=Universe Tech
COMPANY_REPRESENTATIVE=Murenzi Charles
COMPANY_TIN=

# --- Social media (an icon becomes a link when its address is set) ---------------------------
FACEBOOK_URL=
X_URL=
INSTAGRAM_URL=
LINKEDIN_URL=
YOUTUBE_URL=

# --- Optional ---------------------------------------------------------------------------
# RWF_PER_USD=1450
# After the site has worked on https for a few days:  HSTS_SECONDS=31536000
